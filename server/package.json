        "csv-parser": "^3.2.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-validator": "^7.0.0",
        "json2csv": "6.0.0-alpha.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.0.0",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "pdfkit": "^0.17.2"
    },
    "devDependencies": {
        "jest": "^29.7.0",
